<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.joutio</groupId>
        <artifactId>joutio-profile</artifactId>
        <version>4.2.3-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>joutio-profile-infrastructure</artifactId>

    <properties>
        <joutio.matchmaking-domain.version>3.0.0</joutio.matchmaking-domain.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.joutio</groupId>
            <artifactId>joutio-profile-domain</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.joutio</groupId>
            <artifactId>joutio-microservice-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.joutio</groupId>
            <artifactId>joutio-identity-domain</artifactId>
            <version>2.5.1</version>
        </dependency>
        <dependency>
            <groupId>com.joutio</groupId>
            <artifactId>joutio-game-domain</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.joutio</groupId>
            <artifactId>joutio-social-domain</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.joutio</groupId>
            <artifactId>joutio-matchmaking-domain</artifactId>
            <version>${joutio.matchmaking-domain.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.joutio</groupId>
            <artifactId>joutio-axon-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Tests sur le vrai schéma du service (PostgreSQL) -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.joutio.profile.ProfileServiceApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
